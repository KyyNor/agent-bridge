#!/usr/bin/env python3
"""从镜像内的 HumanEval / MBPP 数据生成待沙箱执行的代码。"""

from __future__ import annotations

import json
import os
import random
import sys
import urllib.request
from pathlib import Path
from typing import Any


def load_jsonl(path: Path) -> list[dict[str, Any]]:
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def select_cases(items: list[dict[str, Any]], *, dataset: str, limit: int, mode: str, seed: int) -> list[tuple[int, dict[str, Any]]]:
    indices = list(range(len(items)))
    if mode == "random":
        random.Random(f"{seed}:{dataset}").shuffle(indices)
    return [(index, items[index]) for index in indices[:limit]]


def model_completion(prompt: str, model: str, base_url: str, api_key: str) -> str:
    request = urllib.request.Request(
        f"{base_url.rstrip('/')}/chat/completions",
        data=json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}], "temperature": 0}).encode(),
        headers={"Content-Type": "application/json", **({"Authorization": f"Bearer {api_key}"} if api_key else {})},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=180) as response:  # noqa: S310 - endpoint is admin configured
        payload = json.loads(response.read().decode())
    return str(payload["choices"][0]["message"]["content"])


def prompt_for(dataset: str, item: dict[str, Any]) -> str:
    if dataset == "humaneval":
        return str(item["prompt"])
    return "请只输出可执行的 Python 代码，不要使用 Markdown 代码块。\n\n" + str(item["text"])


def main() -> int:
    if len(sys.argv) != 3:
        raise SystemExit("usage: agent-bridge-code-generate REQUEST.json OUTPUT.json")
    request = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    data_root = Path(os.environ["AGENT_BRIDGE_CODE_DATA_ROOT"])
    api_key = os.environ.get("OPENAI_API_KEY", "")
    base_url = os.environ["OPENAI_BASE_URL"]
    cases: list[dict[str, Any]] = []
    for dataset in request["datasets"]:
        filename = "humaneval.jsonl" if dataset == "humaneval" else "mbpp.jsonl"
        for source_index, item in select_cases(
            load_jsonl(data_root / filename),
            dataset=dataset,
            limit=int(request["max_samples"]),
            mode=request["sampling_mode"],
            seed=int(request["sample_seed"]),
        ):
            completion = model_completion(prompt_for(dataset, item), request["model_name"], base_url, api_key)
            cases.append({
                "dataset": dataset,
                "source_index": source_index,
                "case_id": item.get("task_id", source_index),
                "prompt": item.get("prompt", ""),
                "completion": completion,
                "test": item.get("test", ""),
                "entry_point": item.get("entry_point", ""),
                "test_list": item.get("test_list", []),
            })
    Path(sys.argv[2]).write_text(json.dumps({"cases": cases}, ensure_ascii=False), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
